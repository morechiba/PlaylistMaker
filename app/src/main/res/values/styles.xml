<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ButtonMain" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:textSize">@dimen/text_big</item>
        <item name="android:textColor">@color/button_text</item>
        <item name="android:backgroundTint">@color/button_bg</item>
        <item name="android:layout_marginVertical">@dimen/button_margin</item>
        <item name="android:layout_marginHorizontal">@dimen/padding_main</item>
        <item name="iconGravity">textStart</item>
        <item name="iconSize">24dp</item>
        <item name="iconPadding">@dimen/button_text_padding</item>
        <item name="cornerRadius">@dimen/button_radius</item>
        <item name="iconTint">@color/button_text</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="LayoutBase">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@color/layout_bg</item>
        <item name="android:orientation">vertical</item>
        <item name="android:textColor">@color/text</item>
    </style>
    <style name="TitleBlock">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginBottom">24dp</item>
        <item name="android:orientation">horizontal</item>
    </style>
    <style name="TitleText">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">@dimen/text_big</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
    </style>
    <style name="ArrowBack" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:backgroundTint">@color/layout_bg</item>
        <item name="android:textSize">@dimen/text_big</item>
        <item name="iconTint">@color/text</item>
        <item name="icon">@drawable/arrow_back</item>
    </style>
    <style name="SettingPoint">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/list_height</item>
        <item name="android:textSize">@dimen/text_small</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:paddingVertical">@dimen/list_padding</item>
        <item name="android:layout_marginHorizontal">@dimen/padding_main</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
    </style>
    <style name="TrackTitle">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">@dimen/text_small</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:ellipsize">end</item>
    </style>
    <style name="TrackText">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/track_text</item>
        <item name="android:textSize">@dimen/text_mini</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:ellipsize">end</item>
    </style>
    <style name="TrackArr">
        <item name="android:layout_height">24dp</item>
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_marginStart">@dimen/track_padding</item>
        <item name="android:src">@drawable/arr</item>
        <item name="android:layout_gravity">center</item>
    </style>
    <style name="searchHint">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">20dp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:visibility">gone</item>
    </style>
    <style name="searchHistory">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:visibility">visible</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:orientation">vertical</item>
    </style>
    <style name="searchHistoryTitle">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:padding">20dp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textFontWeight">400</item>
    </style>
    <style name="Placeholder">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:visibility">gone</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:paddingTop">102dp</item>
    </style>
    <style name="PlaceholderImage">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">120dp</item>
    </style>
    <style name="PlaceholderText">
        <item name="android:gravity">center</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:paddingHorizontal">24dp</item>
        <item name="android:paddingVertical">16dp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textFontWeight">400</item>
    </style>
    <style name="PlaceholderButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginVertical">8dp</item>
        <item name="backgroundTint">@color/text</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">54dp</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textFontWeight">500</item>
        <item name="textAllCaps">false</item>
    </style>

</resources>