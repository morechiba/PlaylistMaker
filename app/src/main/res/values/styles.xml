<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ButtonMain" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:textSize">@dimen/text_big</item>
        <item name="android:textColor">@color/button_text</item>
        <item name="android:backgroundTint">@color/button_bg</item>
        <item name="android:layout_marginVertical">@dimen/button_margin</item>
        <item name="android:layout_marginHorizontal">@dimen/padding_main</item>
        <item name="iconGravity">textStart</item>
        <item name="iconSize">24dp</item>
        <item name="iconPadding">@dimen/button_text_padding</item>
        <item name="cornerRadius">@dimen/button_radius</item>
        <item name="iconTint">@color/button_text</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="LayoutBase">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@color/layout_bg</item>
        <item name="android:orientation">vertical</item>
        <item name="android:textColor">@color/text</item>
    </style>
    <style name="TitleBlock">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginBottom">24dp</item>
        <item name="android:orientation">horizontal</item>
    </style>
    <style name="TitleText">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">@dimen/text_big</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
    </style>
    <style name="ArrowBack" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:backgroundTint">@color/layout_bg</item>
        <item name="android:textSize">@dimen/text_big</item>
        <item name="iconTint">@color/text</item>
        <item name="icon">@drawable/arrow_back</item>
    </style>
    <style name="ArrowBackWithoutTitle" parent="ArrowBack">
        <item name="layout_constraintStart_toStartOf">parent</item>
        <item name="layout_constraintTop_toTopOf">parent</item>
    </style>
    <style name="SettingPoint">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/list_height</item>
        <item name="android:textSize">@dimen/text_small</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:paddingVertical">@dimen/list_padding</item>
        <item name="android:layout_marginHorizontal">@dimen/padding_main</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
    </style>
    <style name="TrackImage">
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_width">0dp</item>
        <item name="layout_constraintWidth_max">512dp</item>
        <item name="layout_constraintHeight_max">512dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:layout_marginTop">82dp</item>
        <item name="android:scaleType">centerCrop</item>
        <item name="layout_constraintDimensionRatio">1:1</item>
        <item name="layout_constraintStart_toStartOf">@id/leftGuideline</item>
        <item name="layout_constraintEnd_toStartOf">@id/rightGuideline</item>
        <item name="layout_constraintTop_toTopOf">parent</item>
    </style>
    <style name="TrackTitle">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">@dimen/text_small</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:ellipsize">end</item>
    </style>
    <style name="TrackTitlePlayer">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">@dimen/text_big</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="layout_constraintStart_toStartOf">@id/leftGuideline</item>
        <item name="layout_constraintEnd_toEndOf">@id/rightGuideline</item>
        <item name="layout_constraintTop_toBottomOf">@id/trackImage</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:layout_marginTop">24dp</item>
    </style>
    <style name="TrackAtrist">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="layout_constraintStart_toStartOf">@id/leftGuideline</item>
        <item name="layout_constraintEnd_toEndOf">@id/rightGuideline</item>
        <item name="layout_constraintTop_toBottomOf">@id/trackName</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:layout_marginTop">12dp</item>
    </style>
    <style name="TrackTime">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="layout_constraintTop_toBottomOf">@id/buttonCenter</item>
        <item name="layout_constraintStart_toStartOf">@id/leftGuideline</item>
        <item name="layout_constraintEnd_toEndOf">@id/rightGuideline</item>
        <item name="android:layout_marginTop">4dp</item>
    </style>
    <style name="TrackInfo">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="layout_constrainedWidth">true</item>
        <item name="layout_constraintHorizontal_bias">1</item>
        <item name="android:gravity">right</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="layout_constraintEnd_toEndOf">@id/rightGuideline</item>
        <item name="layout_constraintStart_toEndOf">@id/labelBarrier</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginStart">16dp</item>
    </style>
    <style name="TrackInfoLabel">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:textColor">@color/track_label</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="layout_constraintStart_toStartOf">@id/leftGuideline</item>
        <item name="android:layout_marginTop">16dp</item>
    </style>
    <style name="TrackText">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/track_text</item>
        <item name="android:textSize">@dimen/text_mini</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:ellipsize">end</item>
    </style>
    <style name="TrackArr">
        <item name="android:layout_height">24dp</item>
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_marginStart">@dimen/track_padding</item>
        <item name="android:src">@drawable/arr</item>
        <item name="android:layout_gravity">center</item>
    </style>
    <style name="ButtonPlayerLeft">
        <item name="android:layout_height">51dp</item>
        <item name="android:layout_width">51dp</item>
        <item name="android:background">@null</item>
        <item name="android:src">@drawable/track_add</item>
        <item name="layout_constraintStart_toStartOf">@id/leftGuideline</item>
        <item name="layout_constraintEnd_toStartOf">@id/buttonCenter</item>
        <item name="layout_constraintTop_toBottomOf">@id/trackArtist</item>
        <item name="android:layout_marginTop">54dp</item>
        <item name="android:layout_marginStart">8dp</item>
    </style>
    <style name="ButtonPlayerRight">
        <item name="android:layout_height">51dp</item>
        <item name="android:layout_width">51dp</item>
        <item name="android:background">@null</item>
        <item name="android:src">@drawable/track_fav</item>
        <item name="layout_constraintStart_toEndOf">@id/buttonCenter</item>
        <item name="layout_constraintEnd_toEndOf">@id/rightGuideline</item>
        <item name="layout_constraintTop_toBottomOf">@id/trackArtist</item>
        <item name="android:layout_marginTop">54dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="cornerRadius">50dp</item>
    </style>
    <style name="ButtonPlayerCenter">
        <item name="android:layout_height">100dp</item>
        <item name="android:layout_width">100dp</item>
        <item name="android:background">@null</item>
        <item name="android:src">@drawable/player_play</item>
        <item name="layout_constraintStart_toEndOf">@id/buttonLeft</item>
        <item name="layout_constraintEnd_toStartOf">@id/buttonRight</item>
        <item name="layout_constraintTop_toBottomOf">@id/trackArtist</item>
        <item name="android:layout_marginTop">30dp</item>


    </style>
    <style name="searchHint">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">20dp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:visibility">gone</item>
    </style>
    <style name="searchHistory">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:visibility">gone</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:orientation">vertical</item>
    </style>
    <style name="searchHistoryTitle">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:paddingHorizontal">8dp</item>
        <item name="android:paddingVertical">16dp</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textFontWeight">500</item>
    </style>
    <style name="SearchHistoryWrap">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:orientation">vertical</item>
    </style>
    <style name="SearchHistoryButton" parent="PlaceholderButton">
        <item name="android:layout_marginVertical">24dp</item>
    </style>
    <style name="Placeholder">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:visibility">gone</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:paddingTop">102dp</item>
    </style>
    <style name="PlaceholderImage">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">120dp</item>
    </style>
    <style name="PlaceholderText">
        <item name="android:gravity">center</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:paddingHorizontal">24dp</item>
        <item name="android:paddingVertical">16dp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textFontWeight">400</item>
    </style>
    <style name="PlaceholderButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginVertical">8dp</item>
        <item name="backgroundTint">@color/text</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">54dp</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textFontWeight">500</item>
        <item name="textAllCaps">false</item>
    </style>

</resources>