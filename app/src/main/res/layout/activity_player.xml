<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".PlayerActivity">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/left_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_begin="16dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/right_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_end="16dp" />

    <Button
        android:id="@+id/back"
        style="@style/ArrowBackWithoutTitle" />

    <ImageView
        android:id="@+id/cover_image"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintWidth_max="512dp"
        app:layout_constraintHeight_max="512dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="82dp"
        android:scaleType="centerCrop"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toStartOf="@id/right_guideline"
        app:layout_constraintStart_toStartOf="@id/left_guideline"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@drawable/placeholder_cover" />

    <TextView
        android:id="@+id/track_name"
        style="@style/TrackTitlePlayer"
        tools:text="Yesterday (Remastered 2009)" />
    <TextView
        android:id="@+id/track_artist"
        style="@style/TrackAtrist"
        tools:text="The Beatles" />

    <ImageButton
        android:id="@+id/button_left"
        style="@style/ButtonPlayerLeft"
        app:layout_constraintHorizontal_chainStyle="spread_inside" />
    <ImageButton
        android:id="@+id/button_center"
        style="@style/ButtonPlayerCenter" />
    <ImageButton
        android:id="@+id/button_right"
        style="@style/ButtonPlayerRight" />

    <TextView
        android:id="@+id/track_time_position"
        style="@style/TrackTime"
        tools:text="0:30" />
</androidx.constraintlayout.widget.ConstraintLayout>