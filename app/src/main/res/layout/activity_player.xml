<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingBottom="28dp"
    android:background="@color/layout_bg">
    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:context=".PlayerActivity">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/leftGuideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_begin="16dp" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/rightGuideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_end="16dp" />

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/labelBarrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_tags="track_time_tag, track_album_tag, track_year_tag, track_genre_tag, track_country_tag"
            app:barrierDirection="end" />

        <Button
            android:id="@+id/back"
            style="@style/ArrowBackWithoutTitle" />

        <ImageView
            android:id="@+id/trackImage"
            style="@style/TrackImage"
            tools:src="@drawable/placeholder_cover" />

        <TextView
            android:id="@+id/trackName"
            style="@style/TrackTitlePlayer"
            tools:text="Yesterday (Remastered 2009)" />
        <TextView
            android:id="@+id/trackArtist"
            style="@style/TrackAtrist"
            tools:text="The Beatles" />

        <ImageButton
            android:id="@+id/buttonLeft"
            style="@style/ButtonPlayerLeft"
            app:layout_constraintHorizontal_chainStyle="spread_inside" />
        <ImageButton
            android:id="@+id/buttonCenter"
            style="@style/ButtonPlayerCenter" />
        <ImageButton
            android:id="@+id/buttonRight"
            style="@style/ButtonPlayerRight" />

        <TextView
            android:id="@+id/trackTimePosition"
            style="@style/TrackTime"
            android:text="00:00" />

        <TextView
            android:id="@+id/trackTimeLabel"
            app:layout_constraintTag="track_time_tag"
            style="@style/TrackInfoLabel"
            android:layout_marginTop="38dp"
            app:layout_constraintTop_toBottomOf="@id/trackTimePosition"
            android:text="Длительность" />
        <TextView
            android:id="@+id/trackAlbumLabel"
            app:layout_constraintTag="track_album_tag"
            style="@style/TrackInfoLabel"
            app:layout_constraintTop_toBottomOf="@id/trackTime"
            android:text="Альбом" />
        <TextView
            android:id="@+id/trackYearLabel"
            app:layout_constraintTag="track_year_tag"
            style="@style/TrackInfoLabel"
            app:layout_constraintTop_toBottomOf="@id/trackAlbum"
            android:text="Год" />
        <TextView
            android:id="@+id/trackGenreLabel"
            app:layout_constraintTag="track_genre_tag"
            style="@style/TrackInfoLabel"
            app:layout_constraintTop_toBottomOf="@id/trackYear"
            android:text="Жанр" />
        <TextView
            android:id="@+id/trackCountryLabel"
            app:layout_constraintTag="track_country_tag"
            style="@style/TrackInfoLabel"
            app:layout_constraintTop_toBottomOf="@id/trackGenre"
            android:text="Страна" />

        <TextView
            android:id="@+id/trackTime"
            style="@style/TrackInfo"
            android:layout_marginTop="38dp"
            app:layout_constraintTop_toBottomOf="@id/trackTimePosition"
            tools:text="5:35" />
        <TextView
            android:id="@+id/trackAlbum"
            style="@style/TrackInfo"
            app:layout_constraintTop_toBottomOf="@id/trackTime"
            tools:text="Yesterday (Remastered 2009)" />
        <TextView
            android:id="@+id/trackYear"
            style="@style/TrackInfo"
            app:layout_constraintTop_toBottomOf="@id/trackAlbum"
            tools:text="1965" />
        <TextView
            android:id="@+id/trackGenre"
            style="@style/TrackInfo"
            app:layout_constraintTop_toBottomOf="@id/trackYear"
            tools:text="Rock" />
        <TextView
            android:id="@+id/trackCountry"
            style="@style/TrackInfo"
            app:layout_constraintTop_toBottomOf="@id/trackGenre"
            tools:text="Великобритания" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>