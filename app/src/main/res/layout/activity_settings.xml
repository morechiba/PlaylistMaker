<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    style="@style/LayoutBase">
    <LinearLayout
        style="@style/TitleBlock">
        <Button
            android:id="@+id/back"
            style="@style/ArrowBack"
            />
        <TextView
            style="@style/TitleText"
            android:text="@string/setting"
            />
    </LinearLayout>

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/themeSwitcher"
        android:text="Темная тема"
        android:layout_marginHorizontal="16dp"
        android:layout_gravity="start"
        android:layout_width="match_parent"
        android:layout_height="60dp"/>

    <TextView
        android:id="@+id/share"
        style="@style/SettingPoint"
        android:text="@string/share_app"
        app:drawableEndCompat="@drawable/share"
        />

    <TextView
        android:id="@+id/support"
        style="@style/SettingPoint"
        android:text="@string/write_support"
        app:drawableEndCompat="@drawable/support"
        />

    <TextView
        android:id="@+id/privacy"
        style="@style/SettingPoint"
        android:text="@string/privacy"
        app:drawableEndCompat="@drawable/arr"
        />
</LinearLayout>
